{
  "id": "bluesky",
  "name": "Bluesky",
  "description": "A channel plugin for the Bluesky social network.",
  "activation": { "onStartup": false },
  "channels": ["bluesky"],
  "setup": {
    "env": {
      "BLUESKY_HANDLE": { "type": "string", "description": "Bluesky account handle." },
      "BLUESKY_APP_PASSWORD": { "type": "string", "description": "App password for Bluesky API." },
      "BLUESKY_PDS_URL": { "type": "string", "description": "PDS URL (defaults to bluesky.social if omitted)." }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "bluesky": {
      "label": "Bluesky",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handle": { "type": "string", "description": "The user's visible handle." },
          "appPassword": {
            "description": "The application password required for API authentication.",
            "anyOf": [
              { "type": "string" },
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "source": { "type": "string", "const": "env" },
                      "provider": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
                      "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }
                    },
                    "required": ["source", "provider", "id"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": { "type": "string", "const": "file" },
                      "provider": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
                      "id": { "type": "string" }
                    },
                    "required": ["source", "provider", "id"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": { "type": "string", "const": "exec" },
                      "provider": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
                      "id": { "type": "string" }
                    },
                    "required": ["source", "provider", "id"],
                    "additionalProperties": false
                  }
                ]
              }
            ]
          },
          "pdsUrl": { "type": "string", "description": "The Public Data Store URL." },
          "enabled": { "type": "boolean", "description": "Whether the plugin is enabled for the account." },
          "name": { "type": "string", "description": "Display name for the default account." },
          "defaultAccount": { "type": "string", "description": "Explicit default account id used when no accountId is supplied to outbound sends." },
          "dmPolicy": {
            "type": "string",
            "enum": ["pairing", "allowlist", "open", "disabled"],
            "description": "DM access control policy. Defaults to \"pairing\"."
          },
          "allowFrom": {
            "type": "array",
            "items": { "type": ["string", "number"] },
            "description": "Allowed sender handles or DIDs when dmPolicy is \"allowlist\"."
          },
          "accounts": {
            "type": "object",
            "description": "Account specific settings. Keys map to the accountId.",
            "patternProperties": {
              "^[a-zA-Z0-9_-]+$": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "handle": { "type": "string" },
                  "appPassword": {
                    "anyOf": [
                      { "type": "string" },
                      {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "source": { "type": "string", "const": "env" },
                              "provider": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
                              "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }
                            },
                            "required": ["source", "provider", "id"],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "source": { "type": "string", "const": "file" },
                              "provider": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
                              "id": { "type": "string" }
                            },
                            "required": ["source", "provider", "id"],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "source": { "type": "string", "const": "exec" },
                              "provider": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
                              "id": { "type": "string" }
                            },
                            "required": ["source", "provider", "id"],
                            "additionalProperties": false
                          }
                        ]
                      }
                    ]
                  },
                  "pdsUrl": { "type": "string" },
                  "enabled": { "type": "boolean", "description": "Whether this account is enabled." },
                  "name": { "type": "string", "description": "Display name for this account." },
                  "dmPolicy": {
                    "type": "string",
                    "enum": ["pairing", "allowlist", "open", "disabled"],
                    "description": "DM access control policy. Defaults to \"pairing\"."
                  },
                  "allowFrom": {
                    "type": "array",
                    "items": { "type": ["string", "number"] },
                    "description": "Allowed sender handles or DIDs when dmPolicy is \"allowlist\"."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}